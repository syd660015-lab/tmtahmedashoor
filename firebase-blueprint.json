{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Information about the registered user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "TestResult": {
      "title": "TMT Test Result",
      "description": "A single completion of a TMT part or training level.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["TMT-A", "TMT-B", "Level-1", "Level-2", "Level-3", "Level-4", "Level-5"] },
        "duration": { "type": "number", "description": "Time in seconds" },
        "errors": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "tScore": { "type": "number", "description": "Standardized T-score" },
        "percentile": { "type": "number" },
        "interpretation": { "type": "string" }
      },
      "required": ["userId", "type", "duration", "errors", "timestamp"]
    },
    "AIFeedback": {
      "title": "AI Cognitive Feedback",
      "description": "Personalized feedback generated by Gemini based on test history.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "feedbackText": { "type": "string" },
        "recommendations": { "type": "array", "items": { "type": "string" } },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "feedbackText", "timestamp"]
    },
    "SystemHealth": {
      "title": "System Health",
      "description": "Internal document for connection verification.",
      "type": "object",
      "properties": {
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profile document."
    },
    "test_results/{resultId}": {
      "schema": "TestResult",
      "description": "Collection of all test completions."
    },
    "ai_feedback/{feedbackId}": {
      "schema": "AIFeedback",
      "description": "Feedback generated for users."
    },
    "system/health": {
      "schema": "SystemHealth",
      "description": "Health check document."
    }
  }
}
